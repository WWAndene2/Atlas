{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WWAndene2/atlas/schema/evidence.schema.json",
  "title": "Atlas evidence",
  "description": "A record of where a fact comes from. REA evidence keeps REA's own ID; Atlas's own records use the evd_ prefix.",
  "type": "object",
  "required": ["schema_version", "id", "source", "summary", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^(ev_[0-9a-f]{64}|evd_[0-9a-f]{16,64})$" },
    "source": {
      "enum": ["rea", "engine", "trace", "capture", "verification"],
      "description": "engine: an analysis engine run by Atlas through its adapter, named in tool. rea keeps REA's own records."
    },
    "tool": {
      "type": "object",
      "description": "The engine that produced the evidence, at the version that ran. Required when source is engine.",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "summary": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "if": { "properties": { "source": { "const": "engine" } } },
  "then": { "properties": { "tool": true }, "required": ["tool"] },
  "additionalProperties": false
}
